# ───────────────────────────────────────────────────────────
# ИИ-Академия — конфигурация бэкенда
# ───────────────────────────────────────────────────────────

# === Подключение к PostgreSQL ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/soft_skills

# === JWT ===
SECRET_KEY=soft-skills-platform-secret-key-2026
ACCESS_TOKEN_EXPIRE_HOURS=24

# === CORS ===
CORS_ORIGINS=*

# === Режим ===
DEBUG=true
SQL_ECHO=false

# === Анимация чата ===
AI_TYPING_SPEED_MS=40
AI_THINKING_DELAY_MS=700


# ═══════════════════════════════════════════════════════════
#                    LLM-ПРОВАЙДЕР
# ═══════════════════════════════════════════════════════════
#
# LLM_PROVIDER может быть: mock | gigachat | openai | ollama
#
# Для курсового в РФ — рекомендуем "gigachat" от Сбера.
# Бесплатно, без VPN, русский язык родной.

LLM_PROVIDER=gigachat


# ─── GigaChat от Сбера (БЕСПЛАТНО, РОССИЙСКИЙ) ───
# 1. Перейти на https://developers.sber.ru/
# 2. Войти через Сбер ID
# 3. Перейти в Studio → Проекты → создать проект GigaChat API
# 4. В проекте: Настройки API → Получить ключ
# 5. Скопировать "Authorization Key" (длинная base64-строка, показывается ОДИН раз)
# 6. Вставить ключ ниже

GIGACHAT_AUTH_KEY=MDE5ZGFjMGItM2FjOC03MTQ2LTlkNDktYjNiYzkxMjFkNTZmOjNmMWExYzI3LWJhMmUtNDIxMy04MmJlLTc2NzE4MzUzMTMyOQ==
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Отключена проверка SSL-сертификата российского Минцифры для простоты.
# В production надо установить сертификат с gosuslugi.ru и поставить true.
GIGACHAT_VERIFY_SSL=false


# ─── Альтернативные провайдеры (закомментированы) ───

# OpenAI / Groq / OpenRouter / DeepSeek / Together.ai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Локальный Ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Температура для всех провайдеров: 0.0 — детерминированно, 1.0 — креативно
LLM_TEMPERATURE=0.7
