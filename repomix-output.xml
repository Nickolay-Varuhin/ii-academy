    course_id: Optional[int] = None
    course_title: Optional[str] = None
    due_date: Optional[datetime] = None
    priority: str
    status: str
    created_at: datetime
    completed_at: Optional[datetime] = None
    completion_note: Optional[str] = None


class EmployeePickOut(BaseModel):
